# Copy to deploy/.env for docker compose, or export for local `pnpm dev:api`
PORT=4000
MONGODB_URI=mongodb://localhost:27017/sentinel
REDIS_URL=redis://localhost:6379
STAGING_PATH=./staging
TAPE_ADAPTER=sim
SESSION_SECRET=change-me-in-production
SEARCH_TOKEN_SECRET=change-me-search-token-secret
DOWNLOAD_TOKEN_SECRET=change-me-download-token-secret
DOWNLOAD_TTL_SECONDS=3600
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=info
APP_VERSION=0.1.0-mvp

# Day 11 — PDF certificate signing (RSA or Ed25519 PEM; dev auto-generates Ed25519 in STAGING_PATH)
# CERT_SIGNING_KEY_PATH=/path/to/signing-key.pem

# Portal dev (Vite) — optional in dev; Vite proxies /api when unset
VITE_API_URL=http://localhost:4000
