{
  "name": "biovault-sentinel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @biovault/sentinel-api dev",
    "dev:client": "pnpm --filter @biovault/client-portal dev",
    "dev:admin": "pnpm --filter @biovault/admin-portal dev",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "demo": "bash scripts/demo-mvp.sh",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "compose:up": "docker compose -f deploy/docker-compose.yml --env-file deploy/.env.example up -d",
    "compose:down": "docker compose -f deploy/docker-compose.yml down",
    "docker:demo": "docker build -f deploy/Dockerfile.production -t biovault-demo .",
    "docker:demo:run": "docker run --rm -p 8080:8080 -e SESSION_SECRET=dev-demo-secret -e SEARCH_TOKEN_SECRET=dev-search-secret -e DOWNLOAD_TOKEN_SECRET=dev-download-secret biovault-demo"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0"
}
