{
  "name": "@biovault/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "openapi-typescript openapi.yaml -o src/generated/api.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'contracts: no lint yet'"
  },
  "exports": {
    "./openapi.yaml": "./openapi.yaml",
    "./api": {
      "types": "./src/generated/api.ts",
      "import": "./src/generated/api.ts"
    }
  },
  "devDependencies": {
    "openapi-typescript": "^7.8.0",
    "typescript": "^5.8.3"
  }
}
